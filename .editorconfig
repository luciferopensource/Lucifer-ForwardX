# EditorConfig configuration for Lucifer Infiltrator X
# Documentation: https://editorconfig.org

root = true

# Global baseline defaults
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Python source files (PEP 8 standard)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# YAML configuration files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON metadata and schema files
[*.json]
indent_style = space
indent_size = 2

# TOML configuration files
[*.toml]
indent_style = space
indent_size = 2

# Markdown documentation (preserve trailing whitespace for intentional line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts (must retain LF line endings across all platforms)
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Dockerfile configuration
[Dockerfile*]
indent_style = space
indent_size = 4

# Plain text and citation metadata
[*.{txt,cff}]
indent_style = space
indent_size = 2

# Git configuration files
[{.gitignore,.gitattributes}]
indent_style = space
indent_size = 2
